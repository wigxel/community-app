{
  "name": "wigxel-nextjs-typescript-boilerplate",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "boilerplate",
    "nextjs",
    "wigxel"
  ],
  "type": "module",
  "scripts": {
    "dev:backend": "convex dev",
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:ci": "bunx convex deploy --preview-create $GITHUB_HEAD_REF --cmd \"bun run build\"",
    "start": "next start",
    "commit": "cz",
    "svg:convert": "npx @svgr/cli --icon --typescript --ignore-existing --memo --out-dir ./components/Icons -- public/assets/icons",
    "watch": "watch 'clear && npm run -s lint' pages components",
    "lint": "biome lint . && tsc --noEmit && echo 'Lint complete.'",
    "lint:fix": "eslint --fix . && biome lint --write .",
    "format": "npm run format:prettier && npm run format:biome",
    "format:prettier": "prettier --write .",
    "format:biome": "biome format --no-errors-on-unmatched --write .",
    "format:tsx": "nurm .",
    "test": "vitest --watch=false",
    "test:watch": "vitest",
    "round-check": "npm run lint && npm run format && npm run test && npm run build",
    "test:coverage": "vitest run --coverage --watch=false",
    "email:dev": "email dev --dir emails",
    "prepare": "husky"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.11.4",
    "@hookform/resolvers": "5.2.2",
    "@hyperbridge/ui": "^0.0.50",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.8",
    "@t3-oss/env-nextjs": "0.13.10",
    "@tanstack/react-query": "5.90.12",
    "@tanstack/react-query-devtools": "5.91.1",
    "@wigxel/react-components": "^1.2.7",
    "@wigxel/utils": "1.0.10",
    "better-auth": "1.5.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "consola": "3.4.2",
    "convex": "1.35.1",
    "date-fns": "4.1.0",
    "effect": "3.21.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "hooks-ts": "^0.12.0",
    "iconsax-reactjs": "^0.0.8",
    "lodash-es": "4.17.21",
    "lucide": "^1.33.0",
    "lucide-react": "0.562.0",
    "morphicons": "^1.7.0",
    "motion": "12.9.2",
    "next": "16.2.3",
    "nuqs": "2.8.6",
    "ofetch": "1.5.1",
    "posthog-js": "1.373.5",
    "ramda": "0.27.2",
    "react": "~19.1.4",
    "react-day-picker": "9.14.0",
    "react-dom": "~19.1.4",
    "react-hook-form": "7.71.1",
    "react-image-crop": "11.0.10",
    "react-use-event-hook": "^0.9.6",
    "react-wrap-balancer": "^1.1.1",
    "sharp": "0.34.5",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "typescript": "5.8.3",
    "zeptomail": "7.0.2",
    "zod": "4.3.6",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@eslint/eslintrc": "3.3.1",
    "@react-email/ui": "6.1.5",
    "@svgr/cli": "6.5.1",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.1.2",
    "@wigxel/react-tf": "^0.1.9",
    "@wigxel/react-tf-biome": "^0.1.9",
    "@vitejs/plugin-react-swc": "3.9.0",
    "@vitest/coverage-v8": "4.1.4",
    "autoprefixer": "10.4.21",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "dotenv": "16.5.0",
    "eslint": "9.25.1",
    "eslint-config-next": "15.3.1",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "5.2.6",
    "eslint-plugin-security": "1.7.1",
    "eslint-plugin-sort-destructure-keys": "1.6.0",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "15.5.1",
    "postcss": "8.5.3",
    "postcss-import": "16.1.0",
    "postcss-preset-env": "8.5.1",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.7.2",
    "react-email": "6.1.5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.4",
    "watch": "0.13.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.css": [
      "prettier --write",
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{html,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "effect": "3.22.1"
  },
  "packageManager": "bun@1.3.5"
}
